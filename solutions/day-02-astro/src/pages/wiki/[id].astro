---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("wiki", ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<"wiki"> }
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article>
    <h1>{entry.data.title}</h1>
    <p>{entry.data.summary}</p>
    <time datetime={entry.data.updatedAt.toISOString()}>更新日：{entry.data.updatedAt.toLocaleDateString("ja-JP")}</time>
    <ul class="tags">{entry.data.tags.map((tag) => <li><a class="tag" href={`/tags/${tag}/`}>{tag}</a></li>)}</ul>
    <Content />
  </article>
</BaseLayout>

