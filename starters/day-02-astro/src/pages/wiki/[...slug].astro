---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
    const posts = await getCollection("wiki", ({ data }) => {
        return data.draft !== true;
    })

    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

interface Props {
    post: CollectionEntry<"wiki">;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title}>
    <article>
        <a href="/">記事へ戻る</a>

        <h1>{post.data.title}</h1>
        <p>{post.data.summary}</p>

        <time datetime={post.data.updatedAt.toISOString()}>
            更新日: {post.data.updatedAt.toLocaleDateString("ja-JP")}
        </time>
        
        <div>
            {post.data.tags.map((tag) => (
                <a href={`/tags/${tag}/`}>#{tag}</a>
            ))}
        </div>

        <Content />
    </article>
</BaseLayout>

<style is:global>
      article h2 {
    border-bottom: 2px solid var(--color-primary-light);
    font-size: 1.5rem;
    margin-top: 1rem;
    padding-bottom: 0.2rem;
  }

  article h3 {
    border-bottom: 2px solid var(--color-primary-light);    
    font-size: 1.35rem;
    margin-top: 1rem;
  }

  article p,
  article li {
    line-height: 1.75;
  }

  article code {
    background: var(--color-primary-light);
    border-radius: 0.25rem;
    font-family: 'JetBrains Mono', 'Fira Code', Consolas, 'Courier New', monospace;
    padding: 0.15rem 0.35rem;
  }

  article pre {
    background: #282c34;
    border-radius: 0.5rem;
    color: var(--color-primary-light);
    overflow-x: auto;
    padding: 1.25rem;
  }

  article pre code {
    background: transparent;
    padding: 0;
  }

  article blockquote {
    background: oklch(98.5% 0 none);
    border-left: 4px solid oklch(89.2% 0.058 10.001);
    color: var(--color-muted);
    margin: 1.5rem 0;
    padding: 0.1rem 1.5rem;
  }

  article img {
    border-radius: 0.25rem;
    display: block;
    height: auto;
    margin: 1.5rem auto;
    max-width: 100%;
  }

  article figure {
    margin: 2rem 0;
  }

  article figcaption {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-top: -1rem;
    text-align: center;
  }
</style>