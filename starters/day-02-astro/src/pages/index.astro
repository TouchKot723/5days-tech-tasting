---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
---

<!-- BaseLayoutで全体を包み込んでtitleを渡す -->
<BaseLayout title="ホーム">
  <!-- ここに書いた中身が、BaseLayoutの <slot /> の場所にはまるよ -->
  <h2>Tech Wikiへようこそ！</h2>
  <p>Astroを勉強中だよっ☆</p>

  <ul style="padding; 0;">
    <Card 
      href="/about"
      title="このWikiについて"
      body="Tech Wikiの目的について紹介しています"
    />
    <Card 
      href="https://docs.astro.build"
      title="Astro公式ドキュメント"
      body="公式の最新情報はこちらから！"
    />
  </ul>

</BaseLayout>