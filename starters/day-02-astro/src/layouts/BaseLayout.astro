---
// ページごとに違うtitleをPropsで受け取る
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Tech Wiki</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/">ホーム</a>
        <a href="/about">このページについて</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p><small>&copy; 2026 Tech Wiki</small></p>
    </footer>
  </body>
</html>

